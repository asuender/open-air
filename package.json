{
  "name": "open-air",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "Open source AI-assisted requirements management. Learning experiment for building a monorepo with TypeScript, tRPC, Vite + React, Drizzle and Express.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter @open-air/backend dev",
    "dev:web": "pnpm --filter @open-air/web dev",
    "migrate": "pnpm --filter @open-air/backend migrate",
    "seed": "pnpm --filter @open-air/backend seed",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    "test": "pnpm -r test"
  },
  "lint-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "author": "Andreas Sünder",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "^11.5.2"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260728.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "~6.0.2"
  }
}
